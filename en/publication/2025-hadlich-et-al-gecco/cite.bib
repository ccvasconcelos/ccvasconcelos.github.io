@article{HADLICH2025e03970,
title = {Exploring the potential of field spectroscopy for tree species identification in different Amazonian forest ecosystems},
journal = {Global Ecology and Conservation},
volume = {64},
pages = {e03970},
year = {2025},
issn = {2351-9894},
doi = {https://doi.org/10.1016/j.gecco.2025.e03970},
url = {https://www.sciencedirect.com/science/article/pii/S2351989425005724},
author = {Hilana Louise Hadlich and Jochen Schöngart and Florian Wittmann and Caroline C. Vasconcelos and Caroline L. Mallmann and Maíra L.G. Conde and Priscila {Amaral de Sá} and Layon O. Demarchi and Gisele Biem Mori and Maria T.F. Piedade and Flavia Machado Durgante},
keywords = {Field spectra, Outer bark, Inner bark, Fresh leaf, Tropical forest, Visible and near-infrared spectroscopy, Species identification, Taxonomic errors},
abstract = {Species identification in Amazonian forest inventories is challenging due to a shortage of taxonomists, high biodiversity, and morphological similarities leading to taxonomic errors. Full-range spectroscopy (350–2500 nm) is a promising tool for improving species identification efficiency and reliability. This study assessed the effectiveness of full-range spectroscopy in discriminating against 26 abundant tree species across three Amazonian ecosystems: upland forest, white-sand ecosystems, and floodplain forest, using spectral data from different tree tissues—outer bark, inner bark, and fresh leaves. Each tissue was tested using Linear Discriminant Analysis (LDA) spectral models with two cross-validation methods: leave-one-out and holdout (70/30), as well as external validation with samples from different sites. Results showed high discrimination accuracy for all tissues and ecosystems. The general models achieved 86 % accuracy for outer bark, 97 % for inner bark and 98 % for fresh leaves. The most informative spectral bands varied by tissue type: SWIR I (1300–1900 nm) for outer bark, and VIS (400–700 nm) + SWIR I (1300–1900 nm) for inner bark and fresh leaves. A general model integrating species across ecosystems confirmed full-range spectroscopy as an effective tool for in-field species identification. These findings highlight the potential of spectroscopy to Amazonian biodiversity inventories, contributing to more accurate species identification, refining forest management and conservation efforts.}
}